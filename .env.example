# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=intranetgt
DB_PASSWORD=
DB_NAME=intranetgt
DB_CONNECTION_LIMIT=10

# Secreto usado para firmar el JWT de sesion (HS256). Genera uno fuerte, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET=

# Solo para scripts/seed-admin.mjs (creacion del primer usuario SUPER_ADMIN)
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@example.com
ADMIN_PASSWORD=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Sistema

# Carpeta donde se guardan los archivos generados/subidos (contratos, firmas).
# En el VPS usa una ruta absoluta fuera del repo, ej. /var/intranetgt/uploads
UPLOADS_DIR=./uploads

# Secreto para el cron de vencimiento de contratos (header x-cron-secret).
# Genera uno fuerte igual que SESSION_JWT_SECRET.
CRON_SECRET=

# API de OpenAI -- usada para leer/extraer datos de documentos escaneados:
# la solicitud de registro de contrato al importar uno ya firmado en papel
# (ver src/lib/rrhh/contratos/extraer-solicitud-contrato.ts) y las
# constancias de SUNAT al importar declaraciones de impuestos
# (ver src/lib/facturacion/impuestos/extraer-declaracion.ts). Se genera
# en https://platform.openai.com/ (seccion "API Keys").
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
